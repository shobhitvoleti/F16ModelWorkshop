    "sr_vt": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 270, "y1": 123, "x2": 370, "y2": 223, "rot": 0}}}},
    "ref_map": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 700, "y1": 123, "x2": 800, "y2": 223, "rot": 0}}}},
    "ref_bias": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 750, "y1": 250, "x2": 850, "y2": 350, "rot": 0}}}},
    "ref_sum": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 900, "y1": 150, "x2": 1000, "y2": 250, "rot": 0}}}},
    "zoh": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 1500, "y1": 500, "x2": 1600, "y2": 600, "rot": 0}}}},
    "cmd_map": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 1700, "y1": 500, "x2": 1800, "y2": 600, "rot": 0}}}},
    "zoh_flag": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 1500, "y1": 250, "x2": 1600, "y2": 350, "rot": 0}}}},
    "id1": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2050, "y": 550}, {"x": 2050, "y": 1000}, {"x": 80, "y": 1000}, {"x": 80, "y": 900}], "E": 2}], "renderStyle": "standard"}},

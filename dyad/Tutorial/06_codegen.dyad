"""
Tutorial 6 — step 4's discrete LQG controller on its own, for C code generation.

The clocked `DiscreteStateSpace` and its 100 Hz clock: 12 tracking errors in, 5 absolute
commands out. `TutorialControllerCodegen` compiles it with `SynchToolkit.stkcompile` into
`generated_c/f16_controller/`; each tick, `top_*_step_c` takes `double u[12]` and fills
`double y[5]`.
"""
component ClockedDiscreteController
  "Tracking errors: the 12 state references minus their measurements."
  u = [RealInput() for i in 1:12] {^u}
  "Absolute control commands [T, el, ail, rud, lef]."
  y = [RealOutput() for i in 1:5] {^y}
  "Discrete LQG controller from `TutorialDiscreteLQG`, trim folded into its output offset."
  controller = DiscreteComponents.DiscreteStateSpace(nx = 12, nu = 12, ny = 5, apply "dyad://F16ModelWorkshop/discrete_controller.toml") {^controller}
  "Controller clock, planted on one input; the block clock carries it to the rest."
  clock = DiscreteComponents.PeriodicClock(dt = ControllerTs) {^clock}
relations
  connect(u, controller.u) {^id1}
  connect(clock.y, controller.u[1]) {^id2}
  connect(controller.y, y) {^id3}
metadata {
  "Dyad": {"icons": {"default": "dyad://Dyad/Default.svg"}},
  "_links": {
    "u": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}, "diagram": {"x1": 100, "y1": 450, "x2": 200, "y2": 550}}}},
    "y": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}, "diagram": {"x1": 800, "y1": 450, "x2": 900, "y2": 550}}}},
    "controller": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 400, "y1": 400, "x2": 600, "y2": 600, "rot": 0}}}},
    "clock": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 430, "y1": 690, "x2": 570, "y2": 830, "rot": 0}}}},
    "id1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}},
    "id2": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 300, "y": 760}, {"x": 300, "y": 500}], "E": 2}], "renderStyle": "standard"}},
    "id3": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}}
  }
}
end

"""
Tutorial 6 — compile the 100 Hz controller to C.

`StepCheck` steps the compiled controller against the state-space recursion of
`discrete_controller.toml`: always with the Julia backend, and with the C build when
Clang_unified_jll is loaded. `GeneratedFiles` lists the C sources, each a download.
"""
analysis TutorialControllerCodegen
  extends F16ModelWorkshop.ControllerCodegenAnalysis(export_dir = "generated_c/f16_controller")
  model = ClockedDiscreteController()
end

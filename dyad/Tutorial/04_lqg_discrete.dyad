"""
Tutorial 4 — Discrete (sampled-data) closed-loop LQG.

Sampled version of `LQGDemo` (step 3): the controller is the clocked `DiscreteStateSpace`
with the ZOH-discretized matrices of `discrete_controller.toml` (designed by
`TutorialDiscreteLQG` at Ts = ControllerTs). That asset also carries the trim as the
output operating point `y0`, so `controller.y` is the absolute control command.

Signal flow (all vector ports):
  ref - measurement --> err (12 ch)
  err --> sample (100 Hz) --> controller       continuous -> clocked (12 ch)
  controller --> zoh --> f16plant.u_in         clocked -> continuous (5 ch)

The 100 Hz clock is planted on one controller input; the controller's block clock
carries it to the other eleven, and clock inference to the sampler and hold.
"""
component DiscreteClosedLoopDemo
  "Vector-I/O F16 plant, started 10 deg nose-up of trim."
  f16plant = F16ModelWorkshop.Plant.F16PlantModel(apply "dyad://F16ModelWorkshop/trim_point.toml", theta_init = 0.17453292519943295) {^f16plant}
  "Discrete LQG controller; trim is folded into its output operating point `y0`."
  controller = DiscreteComponents.DiscreteStateSpace(nx = 12, nu = 12, ny = 5, apply "dyad://F16ModelWorkshop/discrete_controller.toml") {^controller}
  "Controller sample clock (100 Hz)."
  clk = DiscreteComponents.PeriodicClock(dt = ControllerTs) {^clk}
  "Reference set-points for the 12 measured states."
  ref = F16ModelWorkshop.VectorBlocks.VectorConstant(n = 12, apply "dyad://F16ModelWorkshop/trim_reference.toml") {^ref}
  "Tracking error: ref - measurement (12 ch)."
  err = F16ModelWorkshop.VectorBlocks.VectorAdd(n = 12, k1 = 1, k2 = -1) {^err}
  "Samples the continuous error onto the controller clock (12 ch)."
  sample = F16ModelWorkshop.VectorBlocks.MultiSampler(n = 12) {^sample}
  "Holds each controller output between ticks as continuous control (5 ch)."
  zoh = F16ModelWorkshop.VectorBlocks.MultiZeroOrderHold(n = 5) {^zoh}
relations
  connect(ref.y, err.u1) {^id8}
  connect(f16plant.y_out, err.u2) {^id9}
  connect(err.y, sample.u) {^id10}
  connect(sample.y, controller.u) {^id11}
  connect(controller.y, zoh.u) {^id12}
  connect(zoh.y, f16plant.u_in) {^id13}
  connect(clk.y, controller.u[1]) {^id14}
metadata {
  "_links": {
    "f16plant": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 1000, "y1": 250, "x2": 1100, "y2": 350, "rot": 0}}}},
    "controller": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 600, "y1": 250, "x2": 700, "y2": 350, "rot": 0}}}},
    "clk": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 600, "y1": 380, "x2": 700, "y2": 480, "rot": 0}}}},
    "ref": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 50, "y1": 223, "x2": 150, "y2": 323, "rot": 0}}}},
    "err": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 230, "y1": 250, "x2": 330, "y2": 350, "rot": 0}}}},
    "sample": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 400, "y1": 250, "x2": 500, "y2": 350, "rot": 0}}}},
    "zoh": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 800, "y1": 250, "x2": 900, "y2": 350, "rot": 0}}}},
    "id8": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}},
    "id9": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1160, "y": 300}, {"x": 1160, "y": 540}, {"x": 180, "y": 540}, {"x": 180, "y": 326}], "E": 2}], "renderStyle": "standard"}},
    "id10": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}},
    "id11": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}},
    "id12": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}},
    "id13": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}},
    "id14": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 560, "y": 430}, {"x": 560, "y": 300}], "E": 2}], "renderStyle": "standard"}}
  }
}
end

"""
Tutorial 4 — fly the 100 Hz regulator.

Starts 10° nose-up of trim. `FlightResponse` shows pitch back at trim within 10 s while
altitude and airspeed barely move, and the elevator as the held value of each tick.
"""
analysis TutorialDiscreteClosedLoop
  extends F16ModelWorkshop.FlightAnalysis(stop = 10.0, panels = ["Pitch attitude (rad), started 10 deg nose-up: f16plant.theta", "Altitude (m): f16plant.alt", "Airspeed (m/s): f16plant.vt", "Elevator (deg), one value per 100 Hz tick: f16plant.el", "Thrust (N): f16plant.T"])
  model = DiscreteClosedLoopDemo()
relations
end

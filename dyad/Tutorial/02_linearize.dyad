"""
Tutorial 2 — Linearize the aircraft at trim.

Find how small control changes affect the 12 aircraft outputs.
Use thrust, elevator, aileron and rudder. This plant ignores the leading-edge flap.

Reuse `LQGDemo` from step 3. Open the feedback loop to study the aircraft alone.
Run `TutorialLinearize` to view poles, zeros and frequency and step responses.
"""
analysis TutorialLinearize
  extends DyadControlSystems.LinearAnalysis(inputs = ["uT", "uEl", "uAil", "uRud"], outputs = ["yn", "ye", "yalt", "yphi", "ypitch", "ypsi", "yvt", "yalpha", "ybeta", "yP", "yQ", "yR"], loop_openings = ["yn", "ye", "yalt", "yphi", "ypitch", "ypsi", "yvt", "yalpha", "ybeta", "yP", "yQ", "yR"])
  model = LQGDemo()
relations
end

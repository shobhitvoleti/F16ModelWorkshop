analysis TutorialTrim
  extends TransientAnalysis(stop = 0.0)
  model = TrimDemo()
relations
end

analysis TutorialTrimExport
  extends F16ModelWorkshop.TrimExportAnalysis(export_dir = "assets")
  model = TrimDemo()
relations
end
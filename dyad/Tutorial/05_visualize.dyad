"""
Tutorial 5 — 3-D visualization.

Renders a closed loop as an animation of the airframe. Each viz model `extends` its
closed loop and adds only a measurement tap, a pose bridge and a visualizer, so the
animation is the same simulation as the earlier steps. Both run the 10 deg pitch
perturbation of step 4, so continuous and sampled-data control can be compared:
  `ContinuousClosedLoopVizDemo`  the LQG regulator of step 3, running continuously
  `DiscreteClosedLoopVizDemo`    the 100 Hz sampled-data loop of step 4

Both render the 10 s window of step 4. The regulator does not hold trim indefinitely:
the `npos`/`epos` error grows with distance flown (see `TutorialLQG`) and the loop
departs at about 19 s, so extending `stop` past that renders the departure, not the
recovery.

Measurement tap (both models), from the plant's vector output:
  f16plant.y_out -> Demux4x3 -> y1 [npos,epos,alt] -> Demux3 -> Mux3 -> pose.pos
                             -> y2 [phi,theta,psi] --------------------> pose.ang

`SignalPoseSource` expects a Y-up world frame and the plant reports NED, so the
Demux3/Mux3 pair reorders position to npos->x, alt->y, epos->z. The Euler triple
[phi, theta, psi] is already [roll, pitch, yaw].
"""
component ContinuousClosedLoopDemo
  "Vector-I/O F16 plant, started 10 deg nose-up of trim."
  # Modifications resolve left to right, so theta_init overrides the trim file's value.
  f16plant = F16ModelWorkshop.Plant.F16PlantModel(apply "dyad://F16ModelWorkshop/trim_point.toml", theta_init = 0.17453292519943295) {^f16plant}
  "Continuous LQG controller designed in step 3."
  controller = BlockComponents.Continuous.StateSpace(nx = 12, nu = 12, ny = 5, apply "dyad://F16ModelWorkshop/controller.toml") {^controller}
  "Reference set-points for the 12 measured states."
  ref = F16ModelWorkshop.VectorBlocks.VectorConstant(n = 12, apply "dyad://F16ModelWorkshop/trim_reference.toml") {^ref}
  "Tracking error: ref - measurement (12 ch)."
  err = F16ModelWorkshop.VectorBlocks.VectorAdd(n = 12, k1 = 1, k2 = -1) {^err}
  "Trim control offset [T, el, ail, rud, lef]."
  trim = F16ModelWorkshop.VectorBlocks.VectorConstant(n = 5, apply "dyad://F16ModelWorkshop/trim_controls.toml") {^trim}
  "Absolute control command = controller output + trim (5 ch); `controller.toml` has no output offset."
  ctrl = F16ModelWorkshop.VectorBlocks.VectorAdd(n = 5, k1 = 1, k2 = 1) {^ctrl}
relations
  connect(ref.y, err.u1) {^id1}
  connect(f16plant.y_out, err.u2) {^id2}
  connect(err.y, controller.u) {^id3}
  connect(controller.y, ctrl.u1) {^id4}
  connect(trim.y, ctrl.u2) {^id5}
  connect(ctrl.y, f16plant.u_in) {^id6}
metadata {
  "_links": {
    "f16plant": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 850, "y1": 150, "x2": 950, "y2": 250, "rot": 0}}}},
    "controller": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 450, "y1": 150, "x2": 550, "y2": 250, "rot": 0}}}},
    "ref": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 50, "y1": 70, "x2": 150, "y2": 170, "rot": 0}}}},
    "err": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 250, "y1": 150, "x2": 350, "y2": 250, "rot": 0}}}},
    "trim": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 450, "y1": 290, "x2": 550, "y2": 390, "rot": 0}}}},
    "ctrl": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 650, "y1": 150, "x2": 750, "y2": 250, "rot": 0}}}},
    "id1": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 200, "y": 120}, {"x": 200, "y": 173}], "E": 2}], "renderStyle": "standard"}},
    "id2": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1000, "y": 200}, {"x": 1000, "y": 450}, {"x": 220, "y": 450}, {"x": 220, "y": 226}], "E": 2}], "renderStyle": "standard"}},
    "id3": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}},
    "id4": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 600, "y": 200}, {"x": 600, "y": 173}], "E": 2}], "renderStyle": "standard"}},
    "id5": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 620, "y": 340}, {"x": 620, "y": 226}], "E": 2}], "renderStyle": "standard"}},
    "id6": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}}
  }
}
end

"Continuous closed loop (step 3's regulator) with the airframe rendered from its pose."
component ContinuousClosedLoopVizDemo
  extends ContinuousClosedLoopDemo
  "Stage 1: split the 12-state plant output into four 3-vectors [pos, att, air, rates]."
  demux = F16ModelWorkshop.Utils.Demux4x3() {^demux}
  "Stage 2: split the position group into scalars for the NED -> Y-up reorder."
  demux_pos = F16ModelWorkshop.Utils.Demux3() {^demux_pos}
  "Regather the position scalars in the pose source's Y-up order [npos, alt, epos]."
  pose_mux = F16ModelWorkshop.Utils.Mux3() {^pose_mux}
  "Bridges the plant's position and attitude signals onto a Frame3D pose."
  pose = F16ModelWorkshop.Utils.SignalPoseSource() {^pose}
  "F-16 airframe mesh driven by the pose."
  viz = MultibodyComponents.ShapefileVisualizer(shapefile = F16ModelWorkshop.asset_path("object", "F-16.obj"), shape_scale = 1.4, shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotXYZ(0, 0, 0), [-32.9, 2.5, 0.1])) {^viz}
relations
  connect(f16plant.y_out, demux.u) {^id7}
  connect(demux.y1, demux_pos.u) {^id8} # [npos, epos, alt]
  connect(demux_pos.y1, pose_mux.u1) {^id9} # npos -> x
  connect(demux_pos.y3, pose_mux.u2) {^id10} # alt  -> y
  connect(demux_pos.y2, pose_mux.u3) {^id11} # epos -> z
  connect(pose_mux.y, pose.pos) {^id12}
  connect(demux.y2, pose.ang) {^id13} # [phi, theta, psi]
  connect(pose.frame_a, viz.frame_a) {^id14}
metadata {
  "_links": {
    "demux": {"Dyad": {"placement": {"diagram": {"x1": 1170, "y1": 450, "x2": 1270, "y2": 550}}}},
    "demux_pos": {"Dyad": {"placement": {"diagram": {"x1": 1170, "y1": 10, "x2": 1270, "y2": 110}}}},
    "pose_mux": {"Dyad": {"placement": {"diagram": {"x1": 1240, "y1": 120, "x2": 1340, "y2": 220}}}},
    "pose": {"Dyad": {"placement": {"diagram": {"x1": 1310, "y1": 120, "x2": 1410, "y2": 220}}}},
    "viz": {"Dyad": {"placement": {"diagram": {"x1": 1460, "y1": 120, "x2": 1560, "y2": 220}}}},
    "id7": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1030, "y": 500}, {"x": 1030, "y": 196}], "E": 2}]}},
    "id8": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1280, "y": 462.5}, {"x": 1280, "y": 60}], "E": 2}]}},
    "id9": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "id10": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "id11": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "id12": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "id13": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1300, "y": 487.5}, {"x": 1300, "y": 198}], "E": 2}]}},
    "id14": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}}
  }
}
end

"Sampled-data closed loop (step 4's 100 Hz controller) with the airframe rendered from its pose."
component DiscreteClosedLoopVizDemo
  extends DiscreteClosedLoopDemo
  "Stage 1: split the 12-state plant output into four 3-vectors [pos, att, air, rates]."
  demux = F16ModelWorkshop.Utils.Demux4x3() {^demux}
  "Stage 2: split the position group into scalars for the NED -> Y-up reorder."
  demux_pos = F16ModelWorkshop.Utils.Demux3() {^demux_pos}
  "Regather the position scalars in the pose source's Y-up order [npos, alt, epos]."
  pose_mux = F16ModelWorkshop.Utils.Mux3() {^pose_mux}
  "Bridges the plant's position and attitude signals onto a Frame3D pose."
  pose = F16ModelWorkshop.Utils.SignalPoseSource() {^pose}
  "F-16 airframe mesh driven by the pose."
  viz = MultibodyComponents.ShapefileVisualizer(shapefile = F16ModelWorkshop.asset_path("object", "F-16.obj"), shape_scale = 1.4, shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotXYZ(0, 0, 0), [-32.9, 2.5, 0.1])) {^viz}
relations
  connect(f16plant.y_out, demux.u) {^id15}
  connect(demux.y1, demux_pos.u) {^id16} # [npos, epos, alt]
  connect(demux_pos.y1, pose_mux.u1) {^id17} # npos -> x
  connect(demux_pos.y3, pose_mux.u2) {^id18} # alt  -> y
  connect(demux_pos.y2, pose_mux.u3) {^id19} # epos -> z
  connect(pose_mux.y, pose.pos) {^id20}
  connect(demux.y2, pose.ang) {^id21} # [phi, theta, psi]
  connect(pose.frame_a, viz.frame_a) {^id22}
metadata {
  "_links": {
    "demux": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 490, "y1": 690, "x2": 630, "y2": 830, "rot": 0}}}},
    "demux_pos": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 700, "y1": 620, "x2": 820, "y2": 740, "rot": 0}}}},
    "pose_mux": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 900, "y1": 620, "x2": 1020, "y2": 740, "rot": 0}}}},
    "pose": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 1090, "y1": 645, "x2": 1230, "y2": 785, "rot": 0}}}},
    "viz": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 1320, "y1": 655, "x2": 1440, "y2": 775, "rot": 0}}}},
    "id15": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1210, "y": 300}, {"x": 1210, "y": 580}, {"x": 440, "y": 580}, {"x": 440, "y": 760}], "E": 2}], "renderStyle": "standard"}},
    "id16": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 660, "y": 707.5}, {"x": 660, "y": 680}], "E": 2}], "renderStyle": "standard"}},
    "id17": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}},
    "id18": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 840, "y": 716}, {"x": 840, "y": 668}, {"x": 890, "y": 668}, {"x": 890, "y": 680}], "E": 2}], "renderStyle": "standard"}},
    "id19": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 870, "y": 680}, {"x": 870, "y": 716}], "E": 2}], "renderStyle": "standard"}},
    "id20": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}},
    "id21": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 650, "y": 742.5}, {"x": 650, "y": 830}, {"x": 1060, "y": 830}, {"x": 1060, "y": 754.2}], "E": 2}], "renderStyle": "standard"}},
    "id22": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}}
  }
}
end

"""
Renders the continuously-controlled pitch recovery to `assets/f16_continuous_closed_loop.mp4`.

Loads GLMakie to render, so it needs a display.
"""
analysis TutorialVisualizeContinuous
  extends F16ModelWorkshop.VisualizeAnalysis(stop = 10.0, filename = "assets/f16_continuous_closed_loop.mp4")
  model = ContinuousClosedLoopVizDemo()
relations
end

"""
Renders the 100 Hz sampled-data pitch recovery to `assets/f16_discrete_closed_loop.mp4`.

Loads GLMakie to render, so it needs a display.
"""
analysis TutorialVisualizeDiscrete
  extends F16ModelWorkshop.VisualizeAnalysis(stop = 10.0, filename = "assets/f16_discrete_closed_loop.mp4")
  model = DiscreteClosedLoopVizDemo()
relations
end

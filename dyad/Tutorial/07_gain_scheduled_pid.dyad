"""
Dynamic pressure from altitude and true airspeed.

``q̄ = \tfrac{1}{2} ρ(h) V^2``, with the troposphere density of `F16PlantModel`,
``ρ = 1.225 (1 - 0.0065 h / 288.15)^{4.256}``.
"""
component DynamicPressure
  "Altitude, m"
  h = RealInput() {^h}
  "True airspeed, m/s"
  V = RealInput() {^V}
  "Dynamic pressure, Pa"
  qbar = RealOutput() {^qbar}
relations
  qbar = 0.5 * 1.225 * (1 - 0.0065 * h / 288.15) ^ 4.256 * V ^ 2
metadata {
  "Dyad": {"icons": {"default": "dyad://Dyad/Default.svg"}},
  "_links": {
    "h": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300}}}},
    "V": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 700, "x2": 50, "y2": 800}}}},
    "qbar": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}}}}
  }
}
end

"""
Gain schedule of the step-7 autopilot, interpolated in dynamic pressure.

The gain-scheduling procedure of Stevens & Lewis, *Aircraft Control and Simulation*:
`F16ModelWorkshop.ScheduledPID.loop_design` designs the loops at straight-and-level design
points, one per airspeed of `velocities` at `altitude`; `gains` holds one column per point;
the table is interpolated linearly in the ``q̄`` of the sampled altitude and airspeed, and
held at its end columns outside the design points.

``q̄`` is the scheduling variable because every aerodynamic force and moment, and so every
control's effectiveness, is proportional to it. From the first design point to the last,
``q̄`` grows by 47 % and the pitch gain falls by 26 %, keeping the pitch loop's crossover
frequency and phase margin.

Outputs, in the order of `ScheduledPID.SCHEDULE_ROWS`: the standard-form gains of
`GainScheduledPIDDemo`'s three PID controllers, and the trims they add as feed-forward.
"""
component AutopilotGainSchedule@[input clk extends Discrete]
  "Sampled altitude, m"
  h = RealInput@[clk]() {^h}
  "Sampled true airspeed, m/s"
  V = RealInput@[clk]() {^V}
  "Pitch-attitude gain, deg of elevator per rad (negative: positive elevator pitches nose down)"
  K_pitch = RealOutput@[clk]() {^K_pitch}
  "Pitch-attitude derivative time (pitch-rate damping), s"
  Td_pitch = RealOutput@[clk]() {^Td_pitch}
  "Altitude gain, rad of pitch attitude per m"
  K_alt = RealOutput@[clk]() {^K_alt}
  "Altitude integral time, s"
  Ti_alt = RealOutput@[clk]() {^Ti_alt}
  "Altitude derivative time (climb-rate damping), s"
  Td_alt = RealOutput@[clk]() {^Td_alt}
  "Airspeed gain, kN of thrust per m/s"
  K_speed = RealOutput@[clk]() {^K_speed}
  "Airspeed integral time, s"
  Ti_speed = RealOutput@[clk]() {^Ti_speed}
  "Trimmed pitch attitude, rad"
  theta_trim = RealOutput@[clk]() {^theta_trim}
  "Trimmed elevator, deg"
  el_trim = RealOutput@[clk]() {^el_trim}
  "Trimmed thrust, kN"
  T_trim = RealOutput@[clk]() {^T_trim}
  "Dynamic pressure of the sampled flight condition"
  pressure = F16ModelWorkshop.Tutorial.DynamicPressure() {^pressure}
  "Dynamic pressure to interpolation weights, one per design point, summing to one"
  scheduler = MPCComponents.Experimental.LinearMPCScheduler@[clk = clk](rho_grid = qbar_knots) {^scheduler}
  "Gain table: weights in, interpolated gains and trims out"
  table = DiscreteComponents.Examples.MatrixGain(ny = n_rows, nu = n_points, K = gains) {^table}
  "Airspeeds of the design points, m/s, strictly increasing"
  structural parameter velocities::Real[:] = [140.0, 152.4, 170.0]
  "Altitude of the design points, m"
  structural parameter altitude::Real = 3000.0
  "Number of design points (derived)"
  final structural parameter n_points::Integer = size(velocities, 1)
  "Number of scheduled signals, the rows of `gains`"
  final structural parameter n_rows::Integer = 10
  "Interpolation knots: dynamic pressure of each design point, Pa (derived)"
  final structural parameter qbar_knots::Real[n_points] = F16ModelWorkshop.ScheduledPID.knot_pressures(velocities, altitude)
  "Gains and trims, one column per design point (derived)"
  final structural parameter gains::Real[n_rows, n_points] = F16ModelWorkshop.ScheduledPID.gain_table(velocities, altitude)
relations
  connect(h, pressure.h) {^id1}
  connect(V, pressure.V) {^id2}
  connect(pressure.qbar, scheduler.rho) {^id3}
  connect(scheduler.w, table.u) {^id4}
  connect(table.y[1], K_pitch) {^id5}
  connect(table.y[2], Td_pitch) {^id6}
  connect(table.y[3], K_alt) {^id7}
  connect(table.y[4], Ti_alt) {^id8}
  connect(table.y[5], Td_alt) {^id9}
  connect(table.y[6], K_speed) {^id10}
  connect(table.y[7], Ti_speed) {^id11}
  connect(table.y[8], theta_trim) {^id12}
  connect(table.y[9], el_trim) {^id13}
  connect(table.y[10], T_trim) {^id14}
metadata {
  "Dyad": {"icons": {"default": "dyad://Dyad/Default.svg"}},
  "_links": {
    "h": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300}, "diagram": {"x1": -50, "y1": 200, "x2": 50, "y2": 300}}}},
    "V": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 700, "x2": 50, "y2": 800}, "diagram": {"x1": -50, "y1": 700, "x2": 50, "y2": 800}}}},
    "K_pitch": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 100, "x2": 1050, "y2": 200}, "diagram": {"x1": 950, "y1": 100, "x2": 1050, "y2": 200}}}},
    "Td_pitch": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 0, "x2": 1050, "y2": 100}, "diagram": {"x1": 950, "y1": 0, "x2": 1050, "y2": 100}}}},
    "K_alt": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 500, "x2": 1050, "y2": 600}, "diagram": {"x1": 950, "y1": 500, "x2": 1050, "y2": 600}}}},

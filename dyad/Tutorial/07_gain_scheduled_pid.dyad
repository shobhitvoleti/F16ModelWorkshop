"""
Blend three table columns using dynamic pressure, once per controller tick.

Below the first knot use [1, 0, 0]; above the last use [0, 0, 1].
Between knots 1 and 2 use [1-a, a, 0], where a is the fraction across that interval.
Between knots 2 and 3 use [0, 1-b, b]. Weights are nonnegative and sum to one.
"""
component PressureScheduleWeights@[input clk extends Discrete]
  "Sampled dynamic pressure, Pa"
  rho = RealInput@[clk]() {^rho}
  "Weights for the three table columns"
  w = [RealOutput@[clk]() for j in 1:3] {^w}
  "Three strictly increasing pressure knots, Pa"
  parameter rho_grid::Real[3]
  variable a::Real
  variable b::Real
relations
  assert(rho_grid[2] > rho_grid[1], "Pressure knots must increase")
  assert(rho_grid[3] > rho_grid[2], "Pressure knots must increase")
  a = min(1.0, max(0.0, (rho - rho_grid[1]) / (rho_grid[2] - rho_grid[1])))
  b = min(1.0, max(0.0, (rho - rho_grid[2]) / (rho_grid[3] - rho_grid[2])))
  w[1] = 1.0 - a
  w[2] = a - b
  w[3] = b
metadata {
  "Dyad": {"icons": {"default": "dyad://F16ModelWorkshop/pressure_schedule_weights.svg"}, "labels": [{"label": "$(instance)", "x": 500, "y": 1100, "layer": "icon", "attrs": {"font-size": "70", "text-anchor": "middle", "font-family": "Helvetica, Arial, sans-serif"}}, {"label": "rho", "x": 130, "y": 512, "layer": "icon", "attrs": {"font-size": "56", "text-anchor": "start", "font-family": "Helvetica, Arial, sans-serif"}}, {"label": "w", "x": 870, "y": 512, "layer": "icon", "attrs": {"font-size": "56", "text-anchor": "end", "font-family": "Helvetica, Arial, sans-serif"}}]},
  "_links": {
    "rho": {"Dyad": {"placement": {"icon": {"x1": 0.0, "y1": 450.0, "x2": 100.0, "y2": 550.0}}}},
    "w": {"Dyad": {"placement": {"icon": {"x1": 900.0, "y1": 450.0, "x2": 1000.0, "y2": 550.0}}}}
  }
}
end


"""
Dynamic pressure from altitude and airspeed, using the plant's troposphere density.
"""
component DynamicPressure
  "Altitude, m"
  h = RealInput() {^h}
  "True airspeed, m/s"
  V = RealInput() {^V}
  "Dynamic pressure, Pa"
  qbar = RealOutput() {^qbar}
relations
  qbar = 0.5 * 1.225 * (1 - 0.0065 * h / 288.15) ^ 4.256 * V ^ 2
metadata {
  "Dyad": {"icons": {"default": "dyad://F16ModelWorkshop/dynamic_pressure.svg"}, "labels": [{"label": "$(instance)", "x": 500, "y": 1100, "layer": "icon", "attrs": {"font-size": "70", "text-anchor": "middle", "font-family": "Helvetica, Arial, sans-serif"}}, {"label": "h", "x": 130, "y": 262, "layer": "icon", "attrs": {"font-size": "56", "text-anchor": "start", "font-family": "Helvetica, Arial, sans-serif"}}, {"label": "V", "x": 130, "y": 762, "layer": "icon", "attrs": {"font-size": "56", "text-anchor": "start", "font-family": "Helvetica, Arial, sans-serif"}}, {"label": "qbar", "x": 870, "y": 512, "layer": "icon", "attrs": {"font-size": "56", "text-anchor": "end", "font-family": "Helvetica, Arial, sans-serif"}}]},
  "_links": {
    "h": {"Dyad": {"placement": {"icon": {"x1": 0.0, "y1": 200.0, "x2": 100.0, "y2": 300.0}}}},
    "V": {"Dyad": {"placement": {"icon": {"x1": 0.0, "y1": 700.0, "x2": 100.0, "y2": 800.0}}}},
    "qbar": {"Dyad": {"placement": {"icon": {"x1": 900.0, "y1": 450.0, "x2": 1000.0, "y2": 550.0}}}}
  }
}
end

"""
At each tick: sampled altitude and airspeed -> pressure -> three weights -> gains.
For every row, the table output is w[1]*column1 + w[2]*column2 + w[3]*column3.
Only neighboring columns are blended; outside the table the nearest end is used.

Saved design: 140, 152.4 and 170 m/s at 3000 m. No Julia design calls at model setup.
Rows: K_pitch, Td_pitch, K_alt, Ti_alt, Td_alt, K_speed, Ti_speed, theta_trim, el_trim, T_trim.
To change the design points, regenerate both `gains` and `qbar_knots` with `ScheduledPID`.
"""
component AutopilotGainSchedule@[input clk extends Discrete]
  "Sampled altitude, m"
  h = RealInput@[clk]() {^h}
  "Sampled true airspeed, m/s"
  V = RealInput@[clk]() {^V}
  "Pitch-attitude gain, deg of elevator per rad (negative: positive elevator pitches nose down)"
  K_pitch = RealOutput@[clk]() {^K_pitch}
  "Pitch-attitude derivative time (pitch-rate damping), s"
  Td_pitch = RealOutput@[clk]() {^Td_pitch}
  "Altitude gain, rad of pitch attitude per m"
  K_alt = RealOutput@[clk]() {^K_alt}
  "Altitude integral time, s"
  Ti_alt = RealOutput@[clk]() {^Ti_alt}
  "Altitude derivative time (climb-rate damping), s"
  Td_alt = RealOutput@[clk]() {^Td_alt}
  "Airspeed gain, kN of thrust per m/s"
  K_speed = RealOutput@[clk]() {^K_speed}
  "Airspeed integral time, s"
  Ti_speed = RealOutput@[clk]() {^Ti_speed}
  "Trimmed pitch attitude, rad"
  theta_trim = RealOutput@[clk]() {^theta_trim}
  "Trimmed elevator, deg"
  el_trim = RealOutput@[clk]() {^el_trim}
  "Trimmed thrust, kN"
  T_trim = RealOutput@[clk]() {^T_trim}
  "Dynamic pressure of the sampled flight condition"
  pressure = F16ModelWorkshop.Tutorial.DynamicPressure() {^pressure}
  "Dynamic pressure to interpolation weights, one per design point, summing to one"
  scheduler = F16ModelWorkshop.Tutorial.PressureScheduleWeights@[clk = clk](rho_grid = qbar_knots) {^scheduler}
  "Gain table: weights in, interpolated gains and trims out"
  table = DiscreteComponents.Examples.MatrixGain(ny = n_rows, nu = n_points, K = gains) {^table}
  "Number of saved design points"
  final structural parameter n_points::Integer = 3
  "Number of scheduled signals"
  final structural parameter n_rows::Integer = 10
  "Pressure knots for 140, 152.4 and 170 m/s at 3000 m, Pa"
  structural parameter qbar_knots::Real[n_points] = [8909.319075865858, 10557.434011198075, 13136.700065945068]
  "Saved gains and trims; one column per pressure knot"
  structural parameter gains::Real[n_rows, n_points] = [
    [-30.380751515134307, -26.67783790570538, -22.533206920113443],
    [0.43327181973618584, 0.43337415371223864, 0.4380809665938033],
    [0.0022390247531131886, 0.002006340088409029, 0.0017478606880856088],
    [5.781648373740246, 5.6043106730776495, 5.379547665067732],
    [1.4454120934350616, 1.4010776682694124, 1.344886916266933],
    [4.417339115074497, 4.391945327493983, 4.367470685184356],
    [5.170649064462581, 5.144244586794114, 5.103331264171048],
    [0.07462672036232981, 0.059129200651428154, 0.042744363171899356],
    [-0.652618803097518, -0.6949065187612248, -0.7620012850535551],
    [10.41192987568892, 10.794889866362622, 11.878571750087175]
  ]
relations
  connect(h, pressure.h) {^id1}
  connect(V, pressure.V) {^id2}
  connect(pressure.qbar, scheduler.rho) {^id3}
  connect(scheduler.w, table.u) {^id4}
  connect(table.y[1], K_pitch) {^id5}
  connect(table.y[2], Td_pitch) {^id6}
  connect(table.y[3], K_alt) {^id7}
  connect(table.y[4], Ti_alt) {^id8}
  connect(table.y[5], Td_alt) {^id9}
  connect(table.y[6], K_speed) {^id10}
  connect(table.y[7], Ti_speed) {^id11}
  connect(table.y[8], theta_trim) {^id12}
  connect(table.y[9], el_trim) {^id13}
  connect(table.y[10], T_trim) {^id14}
metadata {

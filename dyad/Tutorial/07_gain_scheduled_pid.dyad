"""
Tutorial 7a — design the gain schedule.

Designs the loops at the three design points of `AutopilotGainSchedule`. In `LoopShapes`,
with each design point's own gains the pitch loop crosses 0 dB at the same frequency
everywhere; with the 152.4 m/s gains held fixed, the crossover moves with dynamic pressure.
That difference is what the schedule is for.
"""
analysis TutorialGainScheduleDesign
  extends F16ModelWorkshop.GainScheduleAnalysis(velocities = [140.0, 152.4, 170.0], altitude = 3000.0, fixed_point = 2)
  model = AutopilotGainSchedule()
end

"""
Tutorial 7b — fly the scheduled autopilot.

`FlightResponse` shows the dynamic pressure crossing the middle design point, the
design-point weights handing over there, and the scheduled pitch gain following.
"""
analysis TutorialGainScheduledPID
  extends F16ModelWorkshop.FlightAnalysis(stop = 25.0, panels = ["Airspeed (m/s): f16plant.vt, vt_reference", "Altitude (m): f16plant.alt", "Dynamic pressure, the scheduling variable (Pa): f16plant.qbar", "Weight of each design point (140, 152.4, 170 m/s): schedule.scheduler.w[1], schedule.scheduler.w[2], schedule.scheduler.w[3]", "Scheduled pitch gain (deg of elevator per rad): schedule.K_pitch", "Elevator (deg): f16plant.el", "Thrust (N): f16plant.T"])
  model = GainScheduledPIDDemo()
end

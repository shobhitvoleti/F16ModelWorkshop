    "id1": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2050, "y": 460}, {"x": 2050, "y": 1020}, {"x": 80, "y": 1020}, {"x": 80, "y": 900}], "E": 2}], "renderStyle": "standard"}},
    "id2": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}},

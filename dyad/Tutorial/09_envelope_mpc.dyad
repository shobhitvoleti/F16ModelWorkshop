    "alt_cmd": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 100, "y1": 260, "x2": 200, "y2": 360, "rot": 0}}}},
    "sr_vt": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 270, "y1": 123, "x2": 370, "y2": 223, "rot": 0}}}},
    "sr_alt": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 270, "y1": 260, "x2": 370, "y2": 360, "rot": 0}}}},
    "alpha_ref": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 650, "y1": 300, "x2": 750, "y2": 400, "rot": 0}}}},
    "ref_map": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 900, "y1": 150, "x2": 1000, "y2": 250, "rot": 0}}}},

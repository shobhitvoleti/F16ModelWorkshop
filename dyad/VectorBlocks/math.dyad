"""
Vector constant source, `y = k`: the `n`-wide analogue of `BlockComponents.Sources.Constant`.
"""
component VectorConstant
  "Output connectors."
  y = [RealOutput() for i in 1:n] {^y}
  "Number of channels."
  structural parameter n::Integer = 1
  "Constant output vector."
  parameter k::Real[n] = zeros(n)
relations
  y = k
metadata {
  "Dyad": {"icons": {"default": "dyad://F16ModelWorkshop/vector_constant.svg"}},
  "_links": {
    "y": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 900, "y1": 450, "x2": 1000, "y2": 550, "rot": 0}
        },
        "tags": []
      }
    }
  }
}
end

"""
Vector weighted adder, `y = k1*u1 + k2*u2`: the `n`-wide analogue of
`BlockComponents.Math.Add`. With `k2 = -1` it is a tracking-error block.
"""
component VectorAdd
  "First input vector."
  u1 = [RealInput() for i in 1:n] {^u1}
  "Second input vector."
  u2 = [RealInput() for i in 1:n] {^u2}
  "Output connectors."
  y = [RealOutput() for i in 1:n] {^y}
  "Number of channels."
  structural parameter n::Integer = 1
  "Gain on the first input."
  parameter k1::Real = 1.0
  "Gain on the second input."
  parameter k2::Real = 1.0
relations
  y = k1 * u1 + k2 * u2
metadata {
  "Dyad": {"icons": {"default": "dyad://F16ModelWorkshop/vector_add.svg"}},
  "_links": {
    "u1": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 0, "y1": 180, "x2": 100, "y2": 280, "rot": 0}
        },
        "tags": []
      }
    },
    "u2": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 0, "y1": 710, "x2": 100, "y2": 810, "rot": 0}
        },
        "tags": []
      }
    },
    "y": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 900, "y1": 450, "x2": 1000, "y2": 550, "rot": 0}
        },
        "tags": []
      }
    }
  }
}
end
"""
Outer product of two vectors, flattened with the first index fastest:
`y[(j - 1) * n1 + i] = u1[i] * u2[j]`.

Turns the hat-function weights of two one-dimensional schedulers into the bilinear
weights of the two-dimensional grid they span. Both inputs sum to one, so the output
does too, and at most four of its entries are nonzero.
"""
component OuterProduct
  "First input vector; its index runs fastest in the output."
  u1 = [RealInput() for i in 1:n1] {^u1}
  "Second input vector."
  u2 = [RealInput() for j in 1:n2] {^u2}
  "Flattened outer product."
  y = [RealOutput() for k in 1:n] {^y}
  "Width of the first input."
  structural parameter n1::Integer = 1
  "Width of the second input."
  structural parameter n2::Integer = 1
  "Width of the output (derived)."
  final structural parameter n::Integer = n1 * n2
relations
  for j in 1:n2
    for i in 1:n1
      y[(j - 1) * n1 + i] = u1[i] * u2[j]
    end
  end
end

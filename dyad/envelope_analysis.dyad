"""
Trim and linearize the aircraft across its flight envelope.

The plant is trimmed in straight-and-level flight and linearized at `points` × `points`
flight conditions between the bounds of `velocities` and `altitudes`. The result in
Studio is the figure `Envelope`: trimmed angle of attack, thrust and elevator, and the
pitch divergence rate, each over the grid, with the nodes of the step-9 bank marked. With
`table_dir` set, it also rewrites that lookup table, `envelope_trim_alpha.csv`: the trimmed angle of attack at the
table's own nodes, the asset `EnvelopeMPCDemo` reads its bank from. Backed by
`EnvelopeAnalysisSpec` in src/envelope_analysis.jl.
"""
partial analysis EnvelopeAnalysis
  extends Analysis
  model::Dyad.EmptyComponent = Dyad.EmptyComponent()
  "Lowest and highest airspeed of the grid, m/s."
  parameter velocities::Real[2] = [140.0, 250.0]
  "Lowest and highest altitude of the grid, m."
  parameter altitudes::Real[2] = [0.0, 9000.0]
  "Grid points along each axis."
  parameter points::Integer = 100
  "Directory to rewrite the lookup table in at its own nodes, relative to the project root; empty to leave it."
  parameter table_dir::String = ""
end

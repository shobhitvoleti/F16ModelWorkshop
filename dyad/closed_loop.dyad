"""
Rationale:

y1, y2 (npos, epos): 0.01 - Low priority, position drift acceptable
y3 (altitude): 100.0 - High priority, maintain altitude
y4 (phi roll): 10.0 - Medium priority, wings-level important
y5 (theta pitch): 50.0 - High priority, pitch attitude control critical
y6 (psi yaw): 1.0 - Low priority, heading less critical
y7 (velocity): 10.0 - Medium priority, airspeed regulation
y8 (alpha): 1000.0 - Very high priority, angle of attack safety critical
y9 (beta): 1000.0 - Very high priority, sideslip should be near zero
y10 (P roll rate): 10.0 - Medium priority, dampen roll oscillations
y11 (Q pitch rate): 50.0 - High priority, pitch rate stability critical
y12 (R yaw rate): 10.0 - Medium priority, yaw damping

Rationale:

u1 (Thrust): 1e-8 - Very low penalty, thrust changes relatively cheap
u2 (Elevator): 1.0 - Moderate penalty, primary pitch control
u3 (Aileron): 0.1 - Low penalty, roll control relatively cheap
u4 (Rudder): 0.1 - Low penalty, yaw control
u5 (LEF): 10.0 - Higher penalty, LEF slower actuator, use sparingly
"""
analysis F16LQGControllerAnalysis
  extends DyadControlSystems.LQGAnalysis(measurement = ["y1", "y2", "y3", "y4", "y5", "y6", "y7", "y8", "y9", "y10", "y11", "y12"], 
    controlled_output = ["y1", "y2", "y3", "y4", "y5", "y6", "y7", "y8", "y9", "y10", "y11", "y12"], 
    control_input = ["u1", "u2", "u3", "u4", "u5"], 
    loop_openings = [], 
    q1_diag = [0.01, 0.01, 100.0, 10.0, 50.0, 1.0, 10.0, 1000.0, 1000.0, 10.0, 50.0, 10.0], 
    q2_diag = [1e-8, 1.0, 0.1, 0.1, 10.0], 
    r1_diag = [0.01, 0.01, 0.01, 0.01, 0.01], 
    r2_diag = [0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01],
  duration = 50.0
  )
  model = ClosedLoopModel()
end
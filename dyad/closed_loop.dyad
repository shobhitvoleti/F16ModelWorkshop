component ClosedLoopModel
  f16plantio = F16ModelWorkshop.F16PlantIO() {^f16plantio}
  constant1 = BlockComponents.Constant(k = 0) {^constant1}
  constant2 = BlockComponents.Constant(k = 0) {^constant2}
  constant3 = BlockComponents.Constant(k = 0) {^constant3}
  constant4 = BlockComponents.Constant(k = 0) {^constant4}
  constant5 = BlockComponents.Constant(k = 0.0) {^constant5}
  terminator = BlockComponents.Terminator() {^terminator}
  terminator1 = BlockComponents.Terminator() {^terminator1}
  terminator2 = BlockComponents.Terminator() {^terminator2}
  terminator3 = BlockComponents.Terminator() {^terminator3}
  terminator4 = BlockComponents.Terminator() {^terminator4}
  terminator5 = BlockComponents.Terminator() {^terminator5}
  terminator6 = BlockComponents.Terminator() {^terminator6}
  terminator7 = BlockComponents.Terminator() {^terminator7}
  terminator8 = BlockComponents.Terminator() {^terminator8}
  terminator9 = BlockComponents.Terminator() {^terminator9}
  terminator10 = BlockComponents.Terminator() {^terminator10}
  terminator11 = BlockComponents.Terminator() {^terminator11}
relations
  initial f16plantio.npos = 0.0
  initial f16plantio.epos = 0.0
  initial f16plantio.alt = 1000.0
  initial f16plantio.phi = 0.0
  initial f16plantio.theta = 0.0
  initial f16plantio.psi = 0.0
  initial f16plantio.vt = 152.4
  initial f16plantio.alpha = 0.05
  initial f16plantio.beta = 0.0
  initial f16plantio.P = 0.0
  initial f16plantio.Q = 0.0
  initial f16plantio.R = 0.0
  u1: analysis_point(constant1.y, f16plantio.T_in)
  u2: analysis_point(constant2.y, f16plantio.el_in)
  u3: analysis_point(constant3.y, f16plantio.ail_in)
  u4: analysis_point(constant4.y, f16plantio.rud_in)
  u5: analysis_point(constant5.y, f16plantio.lef_in)
  y1: analysis_point(f16plantio.npos_out, terminator.u)
  y2: analysis_point(f16plantio.epos_out, terminator4.u)
  y3: analysis_point(f16plantio.alt_out, terminator1.u)
  y4: analysis_point(f16plantio.phi_out, terminator5.u)
  y5: analysis_point(f16plantio.theta_out, terminator2.u)
  y6: analysis_point(f16plantio.psi_out, terminator6.u)
  y7: analysis_point(f16plantio.vt_out, terminator3.u)
  y8: analysis_point(f16plantio.alpha_out, terminator7.u)
  y9: analysis_point(f16plantio.beta_out, terminator8.u)
  y10: analysis_point(f16plantio.P_out, terminator9.u)
  y11: analysis_point(f16plantio.Q_out, terminator10.u)
  y12: analysis_point(f16plantio.R_out, terminator11.u)
  connect(constant1.y, f16plantio.T_in) {^id19}
  connect(constant2.y, f16plantio.el_in) {^id20}
  connect(constant3.y, f16plantio.ail_in) {^id21}
  connect(constant4.y, f16plantio.rud_in) {^id22}
  connect(constant5.y, f16plantio.lef_in) {^id23}
  connect(f16plantio.npos_out, terminator.u) {^id24}
  connect(terminator4.u, f16plantio.epos_out) {^id25}
  connect(f16plantio.alt_out, terminator1.u) {^id26}
  connect(f16plantio.phi_out, terminator5.u) {^id27}
  connect(f16plantio.theta_out, terminator2.u) {^id28}
  connect(f16plantio.psi_out, terminator6.u) {^id29}
  connect(f16plantio.vt_out, terminator3.u) {^id30}
  connect(f16plantio.alpha_out, terminator7.u) {^id31}
  connect(f16plantio.beta_out, terminator8.u) {^id32}
  connect(f16plantio.P_out, terminator9.u) {^id33}
  connect(f16plantio.Q_out, terminator10.u) {^id34}
  connect(f16plantio.R_out, terminator11.u) {^id35}

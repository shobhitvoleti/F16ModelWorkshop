component ClosedLoopModel
  f16plant = F16PlantIO(alt_init = 3000, alpha_init = -0.01695) {^f16plant}
  controller = BlockComponents.StateSpace(nx = 12, nu = 12, ny = 5, A = ControllerA, B = ControllerB, C = ControllerC, D = ControllerD, x0 = fill(0.0, 12), u0 = fill(0.0, 12), y0 = fill(0.0, 5)) {^controller}
  ref_npos = BlockComponents.Constant(k = 0) {^ref_npos}
  ref_epos = BlockComponents.Constant(k = 0) {^ref_epos}
  ref_alt = BlockComponents.Constant(k = 3000) {^ref_alt}
  ref_phi = BlockComponents.Constant(k = 0) {^ref_phi}
  ref_theta = BlockComponents.Constant(k = -0.0170) {^ref_theta}
  ref_psi = BlockComponents.Constant(k = 0) {^ref_psi}
  ref_vt = BlockComponents.Constant(k = 152.4) {^ref_vt}
  ref_alpha = BlockComponents.Constant(k = -0.01695) {^ref_alpha}
  ref_beta = BlockComponents.Constant(k = 0) {^ref_beta}
  ref_P = BlockComponents.Constant(k = 0) {^ref_P}
  ref_Q = BlockComponents.Constant(k = 0) {^ref_Q}
  ref_R = BlockComponents.Constant(k = 0) {^ref_R}
  error1 = BlockComponents.Add(k1 = 1, k2 = -1) {^error1}
  error2 = BlockComponents.Add(k1 = 1, k2 = -1) {^error2}
  error3 = BlockComponents.Add(k1 = 1, k2 = -1) {^error3}
  error4 = BlockComponents.Add(k1 = 1, k2 = -1) {^error4}
  error5 = BlockComponents.Add(k1 = 1, k2 = -1) {^error5}
  error6 = BlockComponents.Add(k1 = 1, k2 = -1) {^error6}
  error7 = BlockComponents.Add(k1 = 1, k2 = -1) {^error7}
  error8 = BlockComponents.Add(k1 = 1, k2 = -1) {^error8}
  error9 = BlockComponents.Add(k1 = 1, k2 = -1) {^error9}
  error10 = BlockComponents.Add(k1 = 1, k2 = -1) {^error10}
  error11 = BlockComponents.Add(k1 = 1, k2 = -1) {^error11}
  error12 = BlockComponents.Add(k1 = 1, k2 = -1) {^error12}
  trim_T = BlockComponents.Constant(k = 28696.23) {^trim_T}
  trim_el = BlockComponents.Constant(k = 0.0459) {^trim_el}
  trim_ail = BlockComponents.Constant(k = 0) {^trim_ail}
  trim_rud = BlockComponents.Constant(k = 0) {^trim_rud}
  trim_lef = BlockComponents.Constant(k = 0) {^trim_lef}
  control_T = BlockComponents.Add(k1 = 1, k2 = 1) {^control_T}
  control_el = BlockComponents.Add(k1 = 1, k2 = 1) {^control_el}
  control_ail = BlockComponents.Add(k1 = 1, k2 = 1) {^control_ail}
  control_rud = BlockComponents.Add(k1 = 1, k2 = 1) {^control_rud}
  control_lef = BlockComponents.Add(k1 = 1, k2 = 1) {^control_lef}
relations
  uT: analysis_point(control_T.y, f16plant.T_in)
  uEl: analysis_point(control_el.y, f16plant.el_in)
  uAil: analysis_point(control_ail.y, f16plant.ail_in)
  uRud: analysis_point(control_rud.y, f16plant.rud_in)
  uLef: analysis_point(control_lef.y, f16plant.lef_in)
  yn: analysis_point(f16plant.npos_out, error1.u2)
  ye: analysis_point(f16plant.epos_out, error2.u2)
  yalt: analysis_point(f16plant.alt_out, error3.u2)
  yphi: analysis_point(f16plant.phi_out, error4.u2)
  ypitch: analysis_point(f16plant.theta_out, error5.u2)
  ypsi: analysis_point(f16plant.psi_out, error6.u2)
  yvt: analysis_point(f16plant.vt_out, error7.u2)
  yalpha: analysis_point(f16plant.alpha_out, error8.u2)
  ybeta: analysis_point(f16plant.beta_out, error9.u2)
  yP: analysis_point(f16plant.P_out, error10.u2)
  yQ: analysis_point(f16plant.Q_out, error11.u2)
  yR: analysis_point(f16plant.R_out, error12.u2)
  connect(ref_npos.y, error1.u1) {^id37}
  connect(f16plant.npos_out, error1.u2) {^id38}
  connect(ref_epos.y, error2.u1) {^id39}
  connect(f16plant.epos_out, error2.u2) {^id40}
  connect(ref_alt.y, error3.u1) {^id41}
  connect(f16plant.alt_out, error3.u2) {^id42}
  connect(ref_phi.y, error4.u1) {^id43}
  connect(f16plant.phi_out, error4.u2) {^id44}
  connect(ref_theta.y, error5.u1) {^id45}
  connect(f16plant.theta_out, error5.u2) {^id46}
  connect(ref_psi.y, error6.u1) {^id47}
  connect(f16plant.psi_out, error6.u2) {^id48}
  connect(ref_vt.y, error7.u1) {^id49}
  connect(f16plant.vt_out, error7.u2) {^id50}
  connect(ref_alpha.y, error8.u1) {^id51}
  connect(f16plant.alpha_out, error8.u2) {^id52}
  connect(ref_beta.y, error9.u1) {^id53}
  connect(f16plant.beta_out, error9.u2) {^id54}
  connect(ref_P.y, error10.u1) {^id55}
  connect(f16plant.P_out, error10.u2) {^id56}
  connect(ref_Q.y, error11.u1) {^id57}
  connect(f16plant.Q_out, error11.u2) {^id58}
  connect(ref_R.y, error12.u1) {^id59}
  connect(f16plant.R_out, error12.u2) {^id60}
  controller.u[1] = error1.y
  controller.u[2] = error2.y
  controller.u[3] = error3.y
  controller.u[4] = error4.y
  controller.u[5] = error5.y
  controller.u[6] = error6.y
  controller.u[7] = error7.y
  controller.u[8] = error8.y
  controller.u[9] = error9.y
  controller.u[10] = error10.y
  controller.u[11] = error11.y
  controller.u[12] = error12.y
  control_T.u1 = controller.y[1]
  connect(trim_T.y, control_T.u2) {^id61}
  connect(control_T.y, f16plant.T_in) {^id62}
  control_el.u1 = controller.y[2]
  connect(trim_el.y, control_el.u2) {^id63}
  connect(control_el.y, f16plant.el_in) {^id64}
  control_ail.u1 = controller.y[3]
  connect(trim_ail.y, control_ail.u2) {^id65}
  connect(control_ail.y, f16plant.ail_in) {^id66}
  control_rud.u1 = controller.y[4]
  connect(trim_rud.y, control_rud.u2) {^id67}
  connect(control_rud.y, f16plant.rud_in) {^id68}
  control_lef.u1 = controller.y[5]
  connect(trim_lef.y, control_lef.u2) {^id69}
  connect(control_lef.y, f16plant.lef_in) {^id70}

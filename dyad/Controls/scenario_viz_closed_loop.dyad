"""
Closed-loop pitch recovery with 3-D visualizer.
F16 starts at 10° pitch perturbation; the LQG controller drives it back to trim.
Pose is fed to MultibodyComponents.ShapefileVisualizer for STL rendering.
"""
test component F16VizClosedLoop
  # ---- Plant (10° pitch perturbation) ----
  f16plant = F16ModelWorkshop.Plant.F16PlantIO(alt_init = 3000, theta_init = 10 * pi / 180)
  # ---- LQG controller ----
  controller = BlockComponents.Continuous.StateSpace(
    nx = 12, nu = 12, ny = 5,
    A = ControllerA, B = ControllerB,
    C = ControllerC, D = ControllerD,
    x0 = fill(0.0, 12), u0 = fill(0.0, 12), y0 = fill(0.0, 5)
  )
  # ---- Reference setpoints ----
  ref_npos  = BlockComponents.Sources.Constant(k = 0)
  ref_epos  = BlockComponents.Sources.Constant(k = 0)
  ref_alt   = BlockComponents.Sources.Constant(k = 3000)
  ref_phi   = BlockComponents.Sources.Constant(k = 0)
  ref_theta = BlockComponents.Sources.Constant(k = -0.0170)
  ref_psi   = BlockComponents.Sources.Constant(k = 0)
  ref_vt    = BlockComponents.Sources.Constant(k = 152.4)
  ref_alpha = BlockComponents.Sources.Constant(k = -0.0170)
  ref_beta  = BlockComponents.Sources.Constant(k = 0)
  ref_P     = BlockComponents.Sources.Constant(k = 0)
  ref_Q     = BlockComponents.Sources.Constant(k = 0)
  ref_R     = BlockComponents.Sources.Constant(k = 0)
  # ---- Error blocks (ref - measurement) ----
  error1  = BlockComponents.Math.Add(k1 = 1, k2 = -1)
  error2  = BlockComponents.Math.Add(k1 = 1, k2 = -1)
  error3  = BlockComponents.Math.Add(k1 = 1, k2 = -1)
  error4  = BlockComponents.Math.Add(k1 = 1, k2 = -1)
  error5  = BlockComponents.Math.Add(k1 = 1, k2 = -1)
  error6  = BlockComponents.Math.Add(k1 = 1, k2 = -1)
  error7  = BlockComponents.Math.Add(k1 = 1, k2 = -1)
  error8  = BlockComponents.Math.Add(k1 = 1, k2 = -1)
  error9  = BlockComponents.Math.Add(k1 = 1, k2 = -1)
  error10 = BlockComponents.Math.Add(k1 = 1, k2 = -1)
  error11 = BlockComponents.Math.Add(k1 = 1, k2 = -1)
  error12 = BlockComponents.Math.Add(k1 = 1, k2 = -1)
  # ---- Trim feedforward ----
  trim_T   = BlockComponents.Sources.Constant(k = 44482.2)
  trim_el  = BlockComponents.Sources.Constant(k = 0)
  trim_ail = BlockComponents.Sources.Constant(k = 0)
  trim_rud = BlockComponents.Sources.Constant(k = 0)
  trim_lef = BlockComponents.Sources.Constant(k = 0)
  # ---- Control adders (controller output + trim) ----
  control_T   = BlockComponents.Math.Add(k1 = 1, k2 = 1)
  control_el  = BlockComponents.Math.Add(k1 = 1, k2 = 1)
  control_ail = BlockComponents.Math.Add(k1 = 1, k2 = 1)
  control_rud = BlockComponents.Math.Add(k1 = 1, k2 = 1)
  control_lef = BlockComponents.Math.Add(k1 = 1, k2 = 1)
  # ---- 3-D visualization ----
  pose = F16ModelWorkshop.Utils.SignalPoseSource()
  viz = MultibodyComponents.ShapefileVisualizer(
    shapefile = "assets/object/F-16.obj",
    shape_scale = 1.4,
    color = [0.6, 0.6, 0.6, 1.0],
    shape_transform = [[1, 0, 0, -32.9], [0, 1, 0, 2.5], [0, 0, 1, 0.1], [0, 0, 0, 1]]
  )
relations
  # ===== Error signals: ref - plant output =====
  connect(ref_npos.y,  error1.u1)
  connect(ref_epos.y,  error2.u1)
  connect(ref_alt.y,   error3.u1)
  connect(ref_phi.y,   error4.u1)
  connect(ref_theta.y, error5.u1)
  connect(ref_psi.y,   error6.u1)
  connect(ref_vt.y,    error7.u1)
  connect(ref_alpha.y, error8.u1)
  connect(ref_beta.y,  error9.u1)
  connect(ref_P.y,     error10.u1)
  connect(ref_Q.y,     error11.u1)
  connect(ref_R.y,     error12.u1)
  connect(f16plant.npos_out,  error1.u2)
  connect(f16plant.epos_out,  error2.u2)
  connect(f16plant.alt_out,   error3.u2)
  connect(f16plant.phi_out,   error4.u2)
  connect(f16plant.theta_out, error5.u2)
  connect(f16plant.psi_out,   error6.u2)
  connect(f16plant.vt_out,    error7.u2)
  connect(f16plant.alpha_out, error8.u2)
  connect(f16plant.beta_out,  error9.u2)
  connect(f16plant.P_out,     error10.u2)
  connect(f16plant.Q_out,     error11.u2)
  connect(f16plant.R_out,     error12.u2)
  # ===== Errors → controller =====
  connect(error1.y,  controller.u[1])
  connect(error2.y,  controller.u[2])
  connect(error3.y,  controller.u[3])
  connect(error4.y,  controller.u[4])
  connect(error5.y,  controller.u[5])
  connect(error6.y,  controller.u[6])
  connect(error7.y,  controller.u[7])
  connect(error8.y,  controller.u[8])
  connect(error9.y,  controller.u[9])
  connect(error10.y, controller.u[10])
  connect(error11.y, controller.u[11])
  connect(error12.y, controller.u[12])
  # ===== Controller + trim → plant =====
  connect(controller.y[1], control_T.u1)
  connect(trim_T.y,        control_T.u2)
  connect(control_T.y,     f16plant.T_in)
  connect(controller.y[2], control_el.u1)
  connect(trim_el.y,       control_el.u2)
  connect(control_el.y,    f16plant.el_in)
  connect(controller.y[3], control_ail.u1)
  connect(trim_ail.y,      control_ail.u2)
  connect(control_ail.y,   f16plant.ail_in)
  connect(controller.y[4], control_rud.u1)
  connect(trim_rud.y,      control_rud.u2)
  connect(control_rud.y,   f16plant.rud_in)
  connect(controller.y[5], control_lef.u1)
  connect(trim_lef.y,      control_lef.u2)
  connect(control_lef.y,   f16plant.lef_in)
  # ===== Plant outputs → pose source (NED → Y-up) =====
  connect(f16plant.npos_out,  pose.pos[1])   # npos → x
  connect(f16plant.alt_out,   pose.pos[2])   # alt  → y
  connect(f16plant.epos_out,  pose.pos[3])   # epos → z
  connect(f16plant.phi_out,   pose.ang[1])   # roll
  connect(f16plant.theta_out, pose.ang[2])   # pitch
  connect(f16plant.psi_out,   pose.ang[3])   # yaw
  # ===== Pose → visualizer =====
  connect(pose.frame_a, viz.frame_a)
end

analysis F16VizClosedLoopAnalysis
  extends TransientAnalysis(stop = 30.0)
  model = F16VizClosedLoop()
end

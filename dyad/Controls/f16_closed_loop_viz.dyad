"Closed-loop pitch recovery with 3-D OBJ visualizer (array-based plant via Mux5 + two-stage Demux)"
test component F16ClosedLoopViz
  # ---- Plant (10° pitch perturbation), vector I/O ----
  f16plant = F16ModelWorkshop.Plant.F16PlantModel(alt_init = 3000, theta_init = 10 * pi / 180) {^f16plant}
  # ---- Vector routing: 5 scalar commands → u_in[1:5]; y_out[1:12] → 4×3 → 12 scalars ----
  mux = F16ModelWorkshop.Utils.Mux5() {^mux}
  # Stage 1: split the 12-state output into 4 groups of 3
  demux = F16ModelWorkshop.Utils.Demux4x3() {^demux}
  # Stage 2: split each group into scalars
  demux_pos = F16ModelWorkshop.Utils.Demux3() {^demux_pos} # [npos, epos, alt]
  demux_att = F16ModelWorkshop.Utils.Demux3() {^demux_att} # [phi, theta, psi]
  demux_air = F16ModelWorkshop.Utils.Demux3() {^demux_air} # [vt, alpha, beta]
  demux_rate = F16ModelWorkshop.Utils.Demux3() {^demux_rate} # [P, Q, R]
  # ---- LQG controller ----
  controller = BlockComponents.Continuous.StateSpace(nx = 12, nu = 12, ny = 5, A = ControllerA, B = ControllerB, C = ControllerC, D = ControllerD, x0 = fill(0.0, 12), u0 = fill(0.0, 12), y0 = fill(0.0, 5)) {^controller}
  # ---- Reference setpoints ----
  ref_npos = BlockComponents.Sources.Constant(k = 0) {^ref_npos}
  ref_epos = BlockComponents.Sources.Constant(k = 0) {^ref_epos}
  ref_alt = BlockComponents.Sources.Constant(k = 3000) {^ref_alt}
  ref_phi = BlockComponents.Sources.Constant(k = 0) {^ref_phi}
  ref_theta = BlockComponents.Sources.Constant(k = -0.0169500) {^ref_theta}
  ref_psi = BlockComponents.Sources.Constant(k = 0) {^ref_psi}
  ref_vt = BlockComponents.Sources.Constant(k = 152.4) {^ref_vt}
  ref_alpha = BlockComponents.Sources.Constant(k = -0.0169500) {^ref_alpha}
  ref_beta = BlockComponents.Sources.Constant(k = 0) {^ref_beta}
  ref_P = BlockComponents.Sources.Constant(k = 0) {^ref_P}
  ref_Q = BlockComponents.Sources.Constant(k = 0) {^ref_Q}
  ref_R = BlockComponents.Sources.Constant(k = 0) {^ref_R}
  # ---- Error blocks (ref − measurement) ----
  error1 = BlockComponents.Math.Add(k1 = 1, k2 = -1) {^error1}
  error2 = BlockComponents.Math.Add(k1 = 1, k2 = -1) {^error2}
  error3 = BlockComponents.Math.Add(k1 = 1, k2 = -1) {^error3}
  error4 = BlockComponents.Math.Add(k1 = 1, k2 = -1) {^error4}
  error5 = BlockComponents.Math.Add(k1 = 1, k2 = -1) {^error5}
  error6 = BlockComponents.Math.Add(k1 = 1, k2 = -1) {^error6}
  error7 = BlockComponents.Math.Add(k1 = 1, k2 = -1) {^error7}
  error8 = BlockComponents.Math.Add(k1 = 1, k2 = -1) {^error8}
  error9 = BlockComponents.Math.Add(k1 = 1, k2 = -1) {^error9}
  error10 = BlockComponents.Math.Add(k1 = 1, k2 = -1) {^error10}
  error11 = BlockComponents.Math.Add(k1 = 1, k2 = -1) {^error11}
  error12 = BlockComponents.Math.Add(k1 = 1, k2 = -1) {^error12}
  # ---- Trim feedforward ----
  trim_T = BlockComponents.Sources.Constant(k = 28696.2327) {^trim_T}
  trim_el = BlockComponents.Sources.Constant(k = 2.6304783) {^trim_el}
  trim_ail = BlockComponents.Sources.Constant(k = 0) {^trim_ail}
  trim_rud = BlockComponents.Sources.Constant(k = 0) {^trim_rud}
  trim_lef = BlockComponents.Sources.Constant(k = 0) {^trim_lef}
  # ---- Control adders (controller output + trim) ----
  control_T = BlockComponents.Math.Add(k1 = 1, k2 = 1) {^control_T}
  control_el = BlockComponents.Math.Add(k1 = 1, k2 = 1) {^control_el}
  control_ail = BlockComponents.Math.Add(k1 = 1, k2 = 1) {^control_ail}
  control_rud = BlockComponents.Math.Add(k1 = 1, k2 = 1) {^control_rud}
  control_lef = BlockComponents.Math.Add(k1 = 1, k2 = 1) {^control_lef}
  # ---- 3-D visualization ----
  pose = F16ModelWorkshop.Utils.SignalPoseSource() {^pose}
  viz = MultibodyComponents.ShapefileVisualizer(shapefile = joinpath("assets", "object", "F-16.obj"), shape_scale = 1.4, shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotXYZ(0, 0, 0), [-32.9, 2.5, 0.1])) {^viz}
relations
  # ===== Plant vector output → stage-1 demux (y_out = [npos,epos,alt,phi,theta,psi,vt,alpha,beta,P,Q,R]) =====
  connect(f16plant.y_out, demux.u) {^id45}
  # ===== Stage-1 groups (3-vectors) → stage-2 demuxers =====
  connect(demux.y1, demux_pos.u) {^id46} # [npos, epos, alt]
  connect(demux.y2, demux_att.u) {^id47} # [phi, theta, psi]
  connect(demux.y3, demux_air.u) {^id48} # [vt, alpha, beta]
  connect(demux.y4, demux_rate.u) {^id49} # [P, Q, R]
  # ===== Reference setpoints → error.u1 =====
  connect(ref_npos.y, error1.u1) {^id50}
  connect(ref_epos.y, error2.u1) {^id51}
  connect(ref_alt.y, error3.u1) {^id52}
  connect(ref_phi.y, error4.u1) {^id53}
  connect(ref_theta.y, error5.u1) {^id54}
  connect(ref_psi.y, error6.u1) {^id55}
  connect(ref_vt.y, error7.u1) {^id56}
  connect(ref_alpha.y, error8.u1) {^id57}
  connect(ref_beta.y, error9.u1) {^id58}
  connect(ref_P.y, error10.u1) {^id59}
  connect(ref_Q.y, error11.u1) {^id60}
  connect(ref_R.y, error12.u1) {^id61}
  # ===== Stage-2 demuxed measurements → error.u2 =====
  connect(demux_pos.y1, error1.u2) {^id62} # npos
  connect(demux_pos.y2, error2.u2) {^id63} # epos
  connect(demux_pos.y3, error3.u2) {^id64} # alt
  connect(demux_att.y1, error4.u2) {^id65} # phi
  connect(demux_att.y2, error5.u2) {^id66} # theta
  connect(demux_att.y3, error6.u2) {^id67} # psi
  connect(demux_air.y1, error7.u2) {^id68} # vt
  connect(demux_air.y2, error8.u2) {^id69} # alpha
  connect(demux_air.y3, error9.u2) {^id70} # beta
  connect(demux_rate.y1, error10.u2) {^id71} # P
  connect(demux_rate.y2, error11.u2) {^id72} # Q
  connect(demux_rate.y3, error12.u2) {^id73} # R
  # ===== Errors → controller (indexed: each scalar error → controller.u[k]) =====
  connect(error1.y, controller.u) {^id74}
  connect(error2.y, controller.u) {^id75}
  connect(error3.y, controller.u) {^id76}
  connect(error4.y, controller.u) {^id77}
  connect(error5.y, controller.u) {^id78}
  connect(error6.y, controller.u) {^id79}
  connect(error7.y, controller.u) {^id80}
  connect(error8.y, controller.u) {^id81}
  connect(error9.y, controller.u) {^id82}
  connect(error10.y, controller.u) {^id83}
  connect(error11.y, controller.u) {^id84}
  connect(error12.y, controller.u) {^id85}
  # ===== Controller + trim → mux → plant u_in[1:5] = [T, el, ail, rud, lef] =====
  connect(controller.y, control_T.u1) {^id86}
  connect(trim_T.y, control_T.u2) {^id87}
  connect(control_T.y, mux.u1) {^id88}
  connect(controller.y, control_el.u1) {^id89}
  connect(trim_el.y, control_el.u2) {^id90}
  connect(control_el.y, mux.u2) {^id91}
  connect(controller.y, control_ail.u1) {^id92}
  connect(trim_ail.y, control_ail.u2) {^id93}
  connect(control_ail.y, mux.u3) {^id94}
  connect(controller.y, control_rud.u1) {^id95}
  connect(trim_rud.y, control_rud.u2) {^id96}
  connect(control_rud.y, mux.u4) {^id97}
  connect(controller.y, control_lef.u1) {^id98}
  connect(trim_lef.y, control_lef.u2) {^id99}
  connect(control_lef.y, mux.u5) {^id100}
  connect(mux.y, f16plant.u_in) {^id101}
  # ===== Stage-2 outputs → pose source (NED → Y-up), indexed scalar → array element =====
  connect(demux_pos.y1, pose.pos) {^id102} # npos  → x
  connect(demux_pos.y3, pose.pos) {^id103} # alt   → y
  connect(demux_pos.y2, pose.pos) {^id104} # epos  → z
  connect(demux_att.y1, pose.ang) {^id105} # roll  (phi)
  connect(demux_att.y2, pose.ang) {^id106} # pitch (theta)
  connect(demux_att.y3, pose.ang) {^id107} # yaw   (psi)
  # ===== Pose → visualizer =====
  connect(pose.frame_a, viz.frame_a) {^id108}

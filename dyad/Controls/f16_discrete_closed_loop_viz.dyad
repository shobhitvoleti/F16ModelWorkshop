"Discrete-time (sampled-data) closed-loop pitch recovery with 3-D OBJ visualizer (pose source + shapefile visualizer)"
test component F16DiscreteClosedLoopViz
  extends F16DiscreteClosedLoop
  # ---- Stage-1 demux: 12-state plant output -> four 3-vector groups ----
  demux = F16ModelWorkshop.Utils.Demux4x3() {^demux}
  # ---- Stage-2 demux: split the position group into scalars ----
  demux_pos = F16ModelWorkshop.Utils.Demux3() {^demux_pos} # [npos, epos, alt]
  # ---- Regather the position scalars in the pose source's Y-up order ----
  pose_mux = F16ModelWorkshop.Utils.Mux3() {^pose_mux} # [npos, alt, epos]
  # ---- Pose source (converts plant signals -> Frame3D) ----
  pose = F16ModelWorkshop.Utils.SignalPoseSource() {^pose}
  # ---- 3-D visualization ----
  viz = MultibodyComponents.ShapefileVisualizer(shapefile = F16ModelWorkshop.asset_path("object", "F-16.obj"), shape_scale = 1.4, shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotXYZ(0, 0, 0), [-32.9, 2.5, 0.1])) {^viz}
relations
  # ===== Plant vector output -> stage-1 demux (y_out = [npos,epos,alt,phi,theta,psi,vt,alpha,beta,P,Q,R]) =====
  connect(f16plant.y_out, demux.u) {^id5}
  # ===== Stage-1 position group -> stage-2 demux =====
  connect(demux.y1, demux_pos.u) {^id6} # [npos, epos, alt]
  # ===== Stage-2 scalars regathered NED -> Y-up =====
  connect(demux_pos.y1, pose_mux.u1) {^id7} # npos -> x
  connect(demux_pos.y3, pose_mux.u2) {^id8} # alt  -> y
  connect(demux_pos.y2, pose_mux.u3) {^id9} # epos -> z
  connect(pose_mux.y, pose.pos) {^id10}
  # ===== Attitude group -> pose source ([phi, theta, psi] matches [roll, pitch, yaw]) =====
  connect(demux.y2, pose.ang) {^id11}
  # ===== Pose -> visualizer =====
  connect(pose.frame_a, viz.frame_a) {^id12}
metadata {
  "_links": {
    "demux": {
      "Dyad": {"placement": {"diagram": {"x1": 600, "y1": 450, "x2": 700, "y2": 550}}}
    },
    "demux_pos": {
      "Dyad": {"placement": {"diagram": {"x1": 600, "y1": 10, "x2": 700, "y2": 110}}}
    },
    "pose_mux": {
      "Dyad": {"placement": {"diagram": {"x1": 740, "y1": 10, "x2": 840, "y2": 110}}}
    },
    "pose": {

"Discrete-time (sampled-data) closed-loop pitch recovery with 3-D OBJ visualizer (pose source + shapefile visualizer)"
test component F16DiscreteClosedLoopViz
  extends F16DiscreteClosedLoop
  # ---- Stage-1 demux: 12-state plant output -> four 3-vector groups ----
  demux = F16ModelWorkshop.Utils.Demux4x3() {^demux}
  # ---- Stage-2 demux: split the groups needed for the pose into scalars ----
  demux_pos = F16ModelWorkshop.Utils.Demux3() {^demux_pos} # [npos, epos, alt]
  # ---- Pose source (converts plant signals -> Frame3D) ----
  pose = F16ModelWorkshop.Utils.SignalPoseSource() {^pose}
  # ---- 3-D visualization ----
  viz = MultibodyComponents.ShapefileVisualizer(shapefile = joinpath("assets", "object", "F-16.obj"), shape_scale = 1.4, shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotXYZ(0, 0, 0), [-32.9, 2.5, 0.1])) {^viz}
relations
  # ===== Plant vector output -> stage-1 demux (y_out = [npos,epos,alt,phi,theta,psi,vt,alpha,beta,P,Q,R]) =====
  connect(ref.y, err.u1) {^id5}
  # ===== Stage-1 groups needed for the pose -> stage-2 demuxers =====
  connect(f16plant.y_out, err.u2) {^id6} # [npos, epos, alt]
  connect(err.y, sample.u) {^id7} # [phi, theta, psi]
  # ===== Stage-2 scalars -> pose source (NED -> Y-up) =====
  connect(sample.y, controller.u) {^id8} # npos -> x
  connect(controller.y, zoh.u) {^id9} # alt  -> y
  connect(zoh.y, f16plant.u_in) {^id10} # epos -> z
  connect(clk.y, controller.u) {^id11} # roll  (phi)
  # ===== Pose -> visualizer =====
  connect(pose.frame_a, viz.frame_a) {^id12}
  connect(demux.u, f16plant.y_out) {^id13}
  connect(demux.y1, pose.pos) {^id14}
metadata {

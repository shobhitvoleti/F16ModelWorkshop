"""
Clocked constant-zero source: emits a genuine clocked `0.0` on its output.

A self-fed `DiscreteComponents.UnitDelay` seeded at `0.0` realizes
`y[k] = y[k-1]` with `y[0] = 0`, so `y` is identically zero yet remains a real
Shift (clocked) variable. Unlike `Sample(0.0)` or a constant expression, a Shift
of a previous value does **not** constant-fold, so it survives `mtkcompile`
structural simplification and keeps its clock partition.

Use it to anchor an otherwise structurally-constant clocked output row (e.g. an
all-zero `C`/`D` row of `DiscreteStateSpace`) to its clock partition. This works
around the SynchToolkit limitation where such a row folds to a constant and
orphans its clock partition ("Found a clock partition that must be discrete ...
but does not have any associated clock").

Clock-agnostic: the output clock is inferred from where `y` is connected/used.
"""
component ClockedZero@[input clk extends Discrete]
  "Clocked output: identically 0.0, but a genuine Shift (clocked) variable."
  y = RealOutput@[clk]()
  "Internal self-fed one-tick register, seeded at 0.0."
  d = DiscreteComponents.UnitDelay(initial_condition = 0.0)
relations
  # y[k] = d.y = d.u@(clk-1) = y@(clk-1), seeded 0 -> stays identically 0 while
  # remaining a clocked Shift variable on the block clock.
  y = d.y
  d.u = y
end

"""
Discrete-time, clocked linear state-space block.

Realizes the *discrete* difference equation:

```
x[k] = A*x[k-1] + B*(u[k-1] - u0)      (state update)
y[k] = C*x[k]   + D*(u[k]   - u0) + y0  (output)
```

where `A`/`B`/`C`/`D` are the **already-discrete** state-space matrices (e.g. a
ZOH-discretized controller). There is no internal discretization — pass discrete
matrices directly. The realization carries an inherent one-sample input delay in
the state path (`x[k]` depends on `u[k-1]`), which is the canonical form for a
strictly-proper sampled-data controller (`D = 0`).

The block is clocked: its sample rate is inferred from the clock reaching its
connectors (place a `PeriodicClock` upstream of `u`, typically through a
`Sampler`). The state register is built from `nx` scalar
`DiscreteComponents.UnitDelay` blocks, each initialized to `x0[i]`.

A `ClockedZero` anchor (`z0`) is added to every output row. It contributes a
clocked `0.0`, leaving the numeric output unchanged, but keeps each row on the
block clock partition even when a row of `C` (and `D`) is all zeros — which would
otherwise fold to the constant `y0[j]` and orphan the clock partition during
`mtkcompile`. See `SYNCHTOOLKIT_ISSUES.md`, Issue 1.

Connectors (matching `BlockComponents.Continuous.StateSpace`):
- `u :: RealInput[nu]`  (clocked) — input signal.
- `y :: RealOutput[ny]` (clocked) — output signal.

Parameters:
- `nx`        — state dimension.
- `nu`        — number of inputs  (length of `u`).
- `ny`        — number of outputs (length of `y`).
- `A` (nx×nx) — discrete state matrix.
- `B` (nx×nu) — discrete input matrix.
- `C` (ny×nx) — discrete output matrix.
- `D` (ny×nu) — discrete feedthrough matrix.
- `x0` (nx)   — initial state (register seed).
- `u0` (nu)   — input operating point.
- `y0` (ny)   — output operating point.
"""
component DiscreteStateSpace@[input clk extends Discrete]
  "Input connectors (clocked)"
  u = [RealInput@[clk]() for i in 1:nu] {^u}
  "Output connectors (clocked)"
  y = [RealOutput@[clk]() for i in 1:ny] {^y}
  "Per-state one-tick delay registers forming the discrete state vector"
  d = [DiscreteComponents.UnitDelay(initial_condition = x0[i]) for i in 1:nx] {^d}
  "Clocked zero anchor: keeps every output row on the block clock partition."
  z0 = ClockedZero() {^z0}
  "Dimension of state vector"
  structural parameter nx::Integer = 2
  "Number of inputs"
  structural parameter nu::Integer = 1
  "Number of outputs"
  structural parameter ny::Integer = 1
  "Discrete state matrix (nx × nx)"
  structural parameter A::Real[nx, nx] = fill(0.0, nx, nx)
  "Discrete input matrix (nx × nu)"
  structural parameter B::Real[nx, nu] = fill(0.0, nx, nu)
  "Discrete output matrix (ny × nx)"
  structural parameter C::Real[ny, nx] = fill(0.0, ny, nx)
  "Discrete feedthrough matrix (ny × nu)"
  structural parameter D::Real[ny, nu] = fill(0.0, ny, nu)
  "Initial state (register seed)"
  structural parameter x0::Real[nx] = zeros(nx)
  "Input operating point"
  parameter u0::Real[nu] = zeros(nu)
  "Output operating point"
  parameter y0::Real[ny] = zeros(ny)
  "Current state (delay outputs collected into a vector)"
  variable x::Real[nx]
  "Next state fed into the delays"
  variable xn::Real[nx]
  "Input deviation from operating point"
  variable du::Real[nu]
relations
  # State register: collect delay outputs as the state vector; drive each delay
  # with the next state. d[i].y = x[i][k] = xn[i][k-1].
  for i in 1:nx
    x[i] = d[i].y
    d[i].u = xn[i]
  end
  du = u - u0
  xn = A * x + B * du
  # Add the clocked zero anchor to every output row. `z0.y*fill(1.0,ny)` is a
  # clocked vector of zeros: it does not change the numeric output but keeps
  # every row in the discrete partition even when a row of C (and D) is all
  # zeros — such a row would otherwise reduce to the constant `y0[j]`, with no
  # clocked variable on its RHS, and orphan the clock partition.
  y = C * x + D * du + y0 + z0.y * fill(1.0, ny)
metadata {
  "_links": {
    "u": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 0, "y1": 450, "x2": 100, "y2": 550, "rot": 0}
        },
        "tags": []
      }
    },
    "y": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 900, "y1": 450, "x2": 1000, "y2": 550, "rot": 0}
        },
        "tags": []
      }
    },
    "d": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 500, "y1": 150, "x2": 600, "y2": 250, "rot": 0}
        },
        "tags": []
      }
    },
    "z0": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 250, "y1": 270, "x2": 350, "y2": 370, "rot": 0}
        },
        "tags": []
      }
    }
  }
}
end

"Minimal validation: 1-state discrete integrator (A=1, B=0.1, C=1) at dt=0.1 s; output ramps 0.1 per tick (x[k]=x[k-1]+0.1)."
test component TestDiscreteStateSpace
  src = BlockComponents.Sources.Constant(k = 1.0)
  samp = DiscreteComponents.Sampler()
  clk = DiscreteComponents.PeriodicClock(dt = 0.1)
  sys = DiscreteStateSpace(nx = 1, nu = 1, ny = 1, A = fill(1.0, 1, 1), B = fill(0.1, 1, 1), C = fill(1.0, 1, 1))
  zoh = DiscreteComponents.ZeroOrderHold()
relations
  connect(src.y, samp.u)
  connect(samp.y, sys.u[1], clk.y)
  connect(sys.y[1], zoh.u)
end

analysis TestDiscreteStateSpaceTransient
  extends TransientAnalysis(stop = 1.0)
  model = TestDiscreteStateSpace()
relations
end
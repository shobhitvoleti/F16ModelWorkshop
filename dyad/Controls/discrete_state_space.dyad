"Minimal validation: 1-state discrete integrator (A=1, B=0.1, C=1) at dt=0.1 s; output ramps 0.1 per tick (x[k]=x[k-1]+0.1)."
test component TestDiscreteStateSpace
  src = BlockComponents.Sources.Constant(k = 1.0)
  samp = DiscreteComponents.Sampler()
  clk = DiscreteComponents.PeriodicClock(dt = 0.1)
  sys = DiscreteComponents.DiscreteStateSpace(nx = 1, nu = 1, ny = 1, A = fill(1.0, 1, 1), B = fill(0.1, 1, 1), C = fill(1.0, 1, 1))
  zoh = DiscreteComponents.ZeroOrderHold()
relations
  connect(src.y, samp.u)
  connect(samp.y, sys.u[1], clk.y)
  connect(sys.y[1], zoh.u)
end

analysis TestDiscreteStateSpaceTransient
  extends TransientAnalysis(stop = 1.0)
  model = TestDiscreteStateSpace()
relations
end

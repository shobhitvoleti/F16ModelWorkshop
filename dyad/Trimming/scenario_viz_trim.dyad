"Open-loop trim with MultibodyComponents.ShapefileVisualizer"
test component F16VizTrim
  # ---- Trim control inputs ----
  T_cmd   = BlockComponents.Sources.Constant(k = 28696.23)
  el_cmd  = BlockComponents.Sources.Constant(k = 2.6305)
  ail_cmd = BlockComponents.Sources.Constant(k = 0.0)
  rud_cmd = BlockComponents.Sources.Constant(k = 0.0)
  lef_cmd = BlockComponents.Sources.Constant(k = 0.0)
  # ---- Signal routing ----
  mux = F16ModelWorkshop.Utils.Mux5()
  # ---- Plant ----
  plant = F16ModelWorkshop.Plant.F16PlantModel(
    alt_init = 3000.0, vt_init = 152.4,
    alpha_init = -0.01695, theta_init = -0.01695,
    beta_init = 0.0, phi_init = 0.0, psi_init = 0.0,
    P_init = 0.0, Q_init = 0.0, R_init = 0.0
  )
  # ---- Pose source (converts signals → Frame3D) ----
  pose = F16ModelWorkshop.Utils.SignalPoseSource()
  # ---- STL visualizer from MultibodyComponents ----
  viz = MultibodyComponents.ShapefileVisualizer(
    shapefile = "assets/object/F-16.obj",
    shape_scale = 1.4,
    color = [0.6, 0.6, 0.6, 1.0],
    shape_transform = [[1, 0, 0, -32.9], [0, 1, 0, 2.5], [0, 0, 1, 0.1], [0, 0, 0, 1]]
  )
relations
  # Constants → Mux → Plant
  connect(T_cmd.y,   mux.u1)
  connect(el_cmd.y,  mux.u2)
  connect(ail_cmd.y, mux.u3)
  connect(rud_cmd.y, mux.u4)
  connect(lef_cmd.y, mux.u5)
  connect(mux.y, plant.u_in)
  # Map plant outputs to pose source (NED → Y-up)
  connect(plant.y_out[1], pose.pos[1])   # npos → x
  connect(plant.y_out[3], pose.pos[2])   # alt  → y
  connect(plant.y_out[2], pose.pos[3])   # epos → z
  connect(plant.y_out[4], pose.ang[1])   # phi
  connect(plant.y_out[5], pose.ang[2])   # theta
  connect(plant.y_out[6], pose.ang[3])   # psi
  # Connect pose frame to visualizer frame
  connect(pose.frame_a, viz.frame_a)
end

analysis F16VizTrimAnalysis
  extends TransientAnalysis(stop = 15.0)
  model = F16VizTrim()
end

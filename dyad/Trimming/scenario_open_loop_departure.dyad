"""
Open-loop pitch departure from trim.

`F16OpenLoopTrim` with `theta_init` 1 degree above the trim attitude and a longer horizon.
At the reference CG the airframe is statically unstable in pitch (Cma = +0.082/rad): a real
pole at about +0.095 rad/s doubles a perturbation every 7.3 s. This is why the aircraft
needs the regulator of tutorial steps 3 and 4.

`plant.xcg = 0.30` makes the airframe statically stable, but these held controls trim it
only at the 0.35 reference: at 0.30 they pitch it nose-down into a dive.

Signal flow: Constants -> Mux5 -> F16PlantModel
"""
test component F16OpenLoopDeparture
  # ---- Trim control inputs, held fixed ----
  T_cmd   = BlockComponents.Sources.Constant(k = 10794.89)
  el_cmd  = BlockComponents.Sources.Constant(k = -0.6949)
  ail_cmd = BlockComponents.Sources.Constant(k = 0.0)
  rud_cmd = BlockComponents.Sources.Constant(k = 0.0)
  lef_cmd = BlockComponents.Sources.Constant(k = 0.0)
  mux = F16ModelWorkshop.Utils.Mux5()
  # ---- Plant, started 1 degree nose-up of the trim attitude ----
  plant = F16ModelWorkshop.Plant.F16PlantModel(
    alt_init = 3000.0, vt_init = 152.4,
    alpha_init = 0.059129, theta_init = 0.076582,
    beta_init = 0.0, phi_init = 0.0, psi_init = 0.0,
    P_init = 0.0, Q_init = 0.0, R_init = 0.0
  )
relations
  connect(T_cmd.y,   mux.u1)
  connect(el_cmd.y,  mux.u2)
  connect(ail_cmd.y, mux.u3)
  connect(rud_cmd.y, mux.u4)
  connect(lef_cmd.y, mux.u5)
  connect(mux.y, plant.u_in)
end

analysis F16OpenLoopDepartureAnalysis
  # 40 s: pitch has tripled and 22 m/s of airspeed is gone, while alpha stays inside
  # the range the coefficient deck was fitted over.
  extends TransientAnalysis(stop = 40.0)
  model = F16OpenLoopDeparture()
end

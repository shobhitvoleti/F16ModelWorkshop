"""
Scenario 1: Disturbance Rejection - Open-Loop vs Closed-Loop

Open-loop model in this file. Closed-loop model in scenario2_closed_loop.dyad.
Both demonstrate LQG controller effectiveness against 10° pitch perturbation.
"""
component F16OpenLoop
  "F16 with constant trim inputs (no feedback control)"
  f16plant = F16ModelWorkshop.F16PlantIO(alt_init = 3000, theta_init = 10 * pi / 180) {^f16plant}
  # Constant trim control inputs
  T_cmd = BlockComponents.Constant(k = 28696.2) {^T_cmd}
  el_cmd = BlockComponents.Constant(k = 0.0459105) {^el_cmd}
  ail_cmd = BlockComponents.Constant(k = 0.0) {^ail_cmd}
  rud_cmd = BlockComponents.Constant(k = 0.0) {^rud_cmd}
  lef_cmd = BlockComponents.Constant(k = 0.0) {^lef_cmd}
relations
  # Connect constant trim inputs to plant
  connect(T_cmd.y, f16plant.T_in) {^id7}
  connect(el_cmd.y, f16plant.el_in) {^id8}
  connect(ail_cmd.y, f16plant.ail_in) {^id9}
  connect(rud_cmd.y, f16plant.rud_in) {^id10}
  connect(lef_cmd.y, f16plant.lef_in) {^id11}
metadata {

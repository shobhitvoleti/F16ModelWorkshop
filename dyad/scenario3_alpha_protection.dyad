"""
Scenario 3: Alpha Protection During Aggressive Pitch Command

Demonstrates LQG controller's ability to protect angle of attack (alpha)
during an 8° pitch-up step command while maintaining altitude and velocity.

The controller has very high alpha weighting (1000×) which should actively
constrain alpha despite the aggressive pitch maneuver.

Architecture:
- 12 reference signals (Step for theta, Constants for others)
- 12 error computations (reference - measurement)
- LQG controller (12-state observer, 12 inputs, 5 outputs)
- Trim control offsets (controller outputs deviations from trim)
- F16 plant (5 inputs, 12 outputs)
"""
component Scenario3AlphaProtection
  structural parameter nx::Integer = 12
  structural parameter nu::Integer = 12
  structural parameter ny::Integer = 5

  parameter A::Real[nx, nx] = zeros(nx, nx)
  parameter B::Real[nx, nu] = zeros(nx, nu)
  parameter C::Real[ny, nx] = zeros(ny, nx)
  parameter D::Real[ny, nu] = zeros(ny, nu)
  f16plant = F16ModelWorkshop.F16PlantIO() {^f16plant}
  controller = BlockComponents.StateSpace(
  nx = 12, 
  nu = 12, 
  ny = 5, 
  A = A,
  B = B,
  C = C,
  D = D,
  x0 = fill(0.0, 12), 
  u0 = fill(0.0, 12), 
  y0 = fill(0.0, 5)
  ) {^controller}
  ref_npos = BlockComponents.Constant(k = 0) {^ref_npos}
  ref_epos = BlockComponents.Constant(k = 0) {^ref_epos}
  ref_alt = BlockComponents.Constant(k = 1000) {^ref_alt}
  ref_phi = BlockComponents.Constant(k = 0) {^ref_phi}
  ref_theta = BlockComponents.Step(height = 0.1396, offset = 0.05, start_time = 5) {^ref_theta}
  ref_psi = BlockComponents.Constant(k = 0) {^ref_psi}
  ref_vt = BlockComponents.Constant(k = 152.4) {^ref_vt}
  ref_alpha = BlockComponents.Constant(k = 0.05) {^ref_alpha}
  ref_beta = BlockComponents.Constant(k = 0) {^ref_beta}
  ref_P = BlockComponents.Constant(k = 0) {^ref_P}
  ref_Q = BlockComponents.Constant(k = 0) {^ref_Q}
  ref_R = BlockComponents.Constant(k = 0) {^ref_R}
  error1 = BlockComponents.Add(k1 = 1, k2 = -1) {^error1}
  error2 = BlockComponents.Add(k1 = 1, k2 = -1) {^error2}
  error3 = BlockComponents.Add(k1 = 1, k2 = -1) {^error3}
  error4 = BlockComponents.Add(k1 = 1, k2 = -1) {^error4}
  error5 = BlockComponents.Add(k1 = 1, k2 = -1) {^error5}
  error6 = BlockComponents.Add(k1 = 1, k2 = -1) {^error6}
  error7 = BlockComponents.Add(k1 = 1, k2 = -1) {^error7}
  error8 = BlockComponents.Add(k1 = 1, k2 = -1) {^error8}
  error9 = BlockComponents.Add(k1 = 1, k2 = -1) {^error9}
  error10 = BlockComponents.Add(k1 = 1, k2 = -1) {^error10}
  error11 = BlockComponents.Add(k1 = 1, k2 = -1) {^error11}
  error12 = BlockComponents.Add(k1 = 1, k2 = -1) {^error12}
  trim_T = BlockComponents.Constant(k = 44482.2) {^trim_T}
  trim_el = BlockComponents.Constant(k = 0) {^trim_el}
  trim_ail = BlockComponents.Constant(k = 0) {^trim_ail}
  trim_rud = BlockComponents.Constant(k = 0) {^trim_rud}
  trim_lef = BlockComponents.Constant(k = 0) {^trim_lef}
  control_T = BlockComponents.Add(k1 = 1, k2 = 1) {^control_T}
  control_el = BlockComponents.Add(k1 = 1, k2 = 1) {^control_el}
  control_ail = BlockComponents.Add(k1 = 1, k2 = 1) {^control_ail}
  control_rud = BlockComponents.Add(k1 = 1, k2 = 1) {^control_rud}
  control_lef = BlockComponents.Add(k1 = 1, k2 = 1) {^control_lef}
relations
  initial f16plant.npos = 0.0
  initial f16plant.epos = 0.0
  initial f16plant.alt = 1000.0
  initial f16plant.phi = 0.0
  initial f16plant.theta = 0.05
  initial f16plant.psi = 0.0
  initial f16plant.vt = 152.4
  initial f16plant.alpha = 0.05
  initial f16plant.beta = 0.0
  initial f16plant.P = 0.0
  initial f16plant.Q = 0.0
  initial f16plant.R = 0.0
  connect(ref_npos.y, error1.u1) {^id38}
  connect(f16plant.npos_out, error1.u2) {^id39}
  connect(ref_epos.y, error2.u1) {^id40}
  connect(f16plant.epos_out, error2.u2) {^id41}
  connect(ref_alt.y, error3.u1) {^id42}
  connect(f16plant.alt_out, error3.u2) {^id43}
  connect(ref_phi.y, error4.u1) {^id44}
  connect(f16plant.phi_out, error4.u2) {^id45}
  connect(ref_theta.y, error5.u1) {^id46}
  connect(f16plant.theta_out, error5.u2) {^id47}
  connect(ref_psi.y, error6.u1) {^id48}
  connect(f16plant.psi_out, error6.u2) {^id49}
  connect(ref_vt.y, error7.u1) {^id50}
  connect(f16plant.vt_out, error7.u2) {^id51}
  connect(ref_alpha.y, error8.u1) {^id52}
  connect(f16plant.alpha_out, error8.u2) {^id53}
  connect(ref_beta.y, error9.u1) {^id54}
  connect(f16plant.beta_out, error9.u2) {^id55}
  connect(ref_P.y, error10.u1) {^id56}
  connect(f16plant.P_out, error10.u2) {^id57}
  connect(ref_Q.y, error11.u1) {^id58}
  connect(f16plant.Q_out, error11.u2) {^id59}
  connect(ref_R.y, error12.u1) {^id60}
  connect(f16plant.R_out, error12.u2) {^id61}
  controller.u[1] = error1.y
  controller.u[2] = error2.y
  controller.u[3] = error3.y
  controller.u[4] = error4.y
  controller.u[5] = error5.y
  controller.u[6] = error6.y
  controller.u[7] = error7.y
  controller.u[8] = error8.y
  controller.u[9] = error9.y
  controller.u[10] = error10.y
  controller.u[11] = error11.y
  controller.u[12] = error12.y
  control_T.u1 = controller.y[1]
  connect(trim_T.y, control_T.u2) {^id62}
  connect(control_T.y, f16plant.T_in) {^id63}
  control_el.u1 = controller.y[2]
  connect(trim_el.y, control_el.u2) {^id64}
  connect(control_el.y, f16plant.el_in) {^id65}
  control_ail.u1 = controller.y[3]
  connect(trim_ail.y, control_ail.u2) {^id66}
  connect(control_ail.y, f16plant.ail_in) {^id67}
  control_rud.u1 = controller.y[4]
  connect(trim_rud.y, control_rud.u2) {^id68}
  connect(control_rud.y, f16plant.rud_in) {^id69}
  control_lef.u1 = controller.y[5]
  connect(trim_lef.y, control_lef.u2) {^id70}
  connect(control_lef.y, f16plant.lef_in) {^id71}
metadata {

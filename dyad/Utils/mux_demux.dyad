"Demux12: split a 12-element vector input into scalar outputs"
component Demux12
  u = [RealInput() for i in 1:12] {^u}
  y1 = RealOutput() {^y1}
  y2 = RealOutput() {^y2}
  y3 = RealOutput() {^y3}
  y4 = RealOutput() {^y4}
  y5 = RealOutput() {^y5}
  y6 = RealOutput() {^y6}
  y7 = RealOutput() {^y7}
  y8 = RealOutput() {^y8}
  y9 = RealOutput() {^y9}
  y10 = RealOutput() {^y10}
  y11 = RealOutput() {^y11}
  y12 = RealOutput() {^y12}
relations
  y1 = u[1]
  y2 = u[2]
  y3 = u[3]
  y4 = u[4]
  y5 = u[5]
  y6 = u[6]
  y7 = u[7]
  y8 = u[8]
  y9 = u[9]
  y10 = u[10]
  y11 = u[11]
  y12 = u[12]
metadata {

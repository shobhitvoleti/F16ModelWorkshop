"Mux5: combine 5 scalar inputs into a vector output"
component Mux5
  u1 = RealInput() {^u1}
  u2 = RealInput() {^u2}
  u3 = RealInput() {^u3}
  u4 = RealInput() {^u4}
  u5 = RealInput() {^u5}
  y = [RealOutput() for i in 1:5] {^y}
relations
  y = [u1, u2, u3, u4, u5]
metadata {
  "Dyad": {
    "icons": {"default": "dyad://F16ModelWorkshop/mux5.svg"}
  },
